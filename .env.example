# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - POLLO FELIZ DURANGO
# ==============================================================================
# Este archivo contiene las variables modelo para el servidor y la base de datos.
# Copia este archivo a '.env' para personalizar en producción.

# --- 1. APLICACIÓN Y SERVIDOR ---
APP_NAME="Pollo Feliz Durango"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:3000
PORT=3000

# --- 2. MOTOR DE BASE DE DATOS (PERSISTENCIA REAL EN DISCO / SQL) ---
# Opciones disponibles para DB_CONNECTION:
# - 'sqlite'     : Archivo SQLite persistente en disco (data/pollofeliz.sqlite) - Predeterminado
# - 'postgres'   : PostgreSQL relacional (Cloud SQL, Neon, Supabase, RDS, DigitalOcean)
# - 'mysql'      : MySQL 8 / MariaDB
DB_CONNECTION=sqlite
DB_SQLITE_PATH=data/pollofeliz.sqlite

# Parámetros para PostgreSQL / MySQL (cuando se active servidor SQL externo):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pollo_feliz
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSL=false

# O alternativamente, usar una URL completa (como en Supabase, Neon o Render):
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_bd?sslmode=require

# --- 3. SEGURIDAD Y AUDITORÍA DE ACCESOS ---
JWT_SECRET=super_secret_jwt_key_change_in_production_256bit
SESSION_LIFETIME=120
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=60
SECURITY_SALT_ROUNDS=10

# --- 4. CREDENCIALES DE ARRANQUE INICIAL (BOOTSTRAP) ---
ADMIN_BOOTSTRAP_NAME="Super Administrador"
ADMIN_BOOTSTRAP_EMAIL="admin@pollofeliz.com"
ADMIN_BOOTSTRAP_PASSWORD="admin123456"

# --- 5. NOTIFICACIONES Y CORREO ELECTRÓNICO (soporte@pollofelizdgo.com) ---
# Destinatario corporativo de formularios de contacto y postulaciones
MAIL_SUPPORT_ADDRESS=soporte@pollofelizdgo.com
FEEDBACK_NOTIFICATION_EMAIL=soporte@pollofelizdgo.com
# Opción A (Recomendada en la nube): API Key de Resend (https://resend.com)
RESEND_API_KEY=
# Opción B (SMTP estándar: Gmail con contraseña de aplicación, cPanel, Hostinger, Mailgun, etc.)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="soporte@pollofelizdgo.com"
MAIL_FROM_NAME="Pollo Feliz Durango"

# --- 6. GOOGLE MAPS & FRONTEND VITE VARIABLES PÚBLICAS ---
GOOGLE_MAPS_API_KEY=
VITE_APP_NAME="Pollo Feliz Durango"
VITE_API_URL=/api
VITE_FACEBOOK="https://facebook.com/pollofelizdurango"
VITE_INSTAGRAM="https://instagram.com/pollofelizdurango"
VITE_WHATSAPP_NUMBER="618-123-4567"